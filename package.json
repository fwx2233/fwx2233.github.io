{
  "name": "hydejack",
  "version": "7.5.2",
  "description": "Build tools for Wenxuan Fu’s personal blog, based on Hydejack 7.5.2.",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "webpack --mode production",
    "build:css": "node .scripts/build-css.js",
    "watch:js": "webpack --mode development --watch",
    "watch:css": "onchange '_sass/**/*.pre.scss' -- npm run build:css",
    "serve": "bundle exec jekyll serve --host=127.0.0.1",
    "lint": "eslint _js/src webpack.config.js .scripts/build-css.js",
    "check:site": "python3 .scripts/check-site.py",
    "test": "playwright test --config .scripts/playwright.config.cjs"
  },
  "config": {
    "port": 4000
  },
  "author": "Florian Klampfer <mail@qwtel.com> (https://qwtel.com/)",
  "license": "GPL-3.0",
  "private": true,
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "babel-loader": "10.1.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "css-loader": "7.1.5",
    "style-loader": "4.0.0",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "globals": "17.12.0",
    "onchange": "7.1.0",
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "color": "3.0.0",
    "core-js": "2.5.7",
    "elem-dataset": "1.1.1",
    "hy-drawer": "1.0.0-pre.21",
    "hy-push-state": "1.0.0-pre.21",
    "rxjs": "6.2.1",
    "web-animations-js": "2.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwx2233/fwx2233.github.io.git"
  },
  "homepage": "https://fwx2233.github.io/",
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
